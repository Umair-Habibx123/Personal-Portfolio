  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/poppins": "^5.2.7",
    "@fontsource/syne": "^5.3.0",
    "@paper-design/shaders": "0.0.81",
    "@react-three/drei": "^9.120.4",
    "@react-three/fiber": "^8.17.10",
    "framer-motion": "^11.15.0",
    "gsap": "^3.13.0",
    "lucide-react": "^0.511.0",
    "nodemailer": "10.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.167.1"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir .ssr --emptyOutDir && node scripts/prerender.mjs",
    "preview": "vite preview",
    "messages:sync": "node --disable-warning=ExperimentalWarning scripts/data.mjs sync",
    "messages:list": "node --disable-warning=ExperimentalWarning scripts/data.mjs messages-full",
    "shaders:list": "node scripts/list-shaders.mjs",
    "chats:list": "node --disable-warning=ExperimentalWarning scripts/data.mjs chats",
    "analytics": "node scripts/analytics.mjs",
    "data:sync": "node --disable-warning=ExperimentalWarning scripts/data.mjs sync",
    "data:report": "node --disable-warning=ExperimentalWarning scripts/data.mjs report",
    "data:messages": "node --disable-warning=ExperimentalWarning scripts/data.mjs messages",
    "data:chats": "node --disable-warning=ExperimentalWarning scripts/data.mjs chats",
    "data:questions": "node --disable-warning=ExperimentalWarning scripts/data.mjs questions",
    "data:answered": "node --disable-warning=ExperimentalWarning scripts/data.mjs answered",
    "data:export": "node --disable-warning=ExperimentalWarning scripts/data.mjs export"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.11"
