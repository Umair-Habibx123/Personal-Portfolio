# Copy this file to .env for local use, and add the same values in
# Vercel → Project → Settings → Environment Variables for the live site.
# Never commit .env.

# ── SMTP: emails each message to you ─────────────────────────────
# Gmail: smtp.gmail.com, port 465, your Gmail address, and an App Password
# (Google Account → Security → 2-Step Verification → App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-character-app-password
# Optional: the "from" address (defaults to SMTP_USER)
MAIL_FROM=
# Where messages are delivered
MAIL_TO=you@gmail.com

# ── Backup: every message is also saved to a PRIVATE GitHub repo ──
# Fine-grained token with access to ONLY that repo, permission
# "Contents: Read and write".
GITHUB_TOKEN=github_pat_xxx
GITHUB_REPO=Umair-Habibx123/portfolio-messages
GITHUB_BRANCH=main

# ── Email verification (visitors confirm their email with a 6-digit code) ──
# A long random string used to sign the pending message. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# (If you leave it out, a key is derived from SMTP_PASS + GITHUB_TOKEN.)
CONTACT_SECRET=

# ── "Ask Umair" AI chat (Google Gemini) ──
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: one model, or several separated by commas (tried in order).
# Default gemini-3.5-flash-lite. Example: gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash
GEMINI_MODEL=

# ── Visit analytics + chat history (Upstash Redis, free tier) ──
# Vercel → Storage (Marketplace) → Upstash for Redis → connect to this project.
# Vercel then adds KV_REST_API_URL and KV_REST_API_TOKEN automatically; copy
# them here for `npm run analytics`. (UPSTASH_REDIS_REST_URL/TOKEN also work.)
KV_REST_API_URL=
KV_REST_API_TOKEN=
