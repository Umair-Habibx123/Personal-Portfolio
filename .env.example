# Copy this file to .env for local use, and add the same values in
# Vercel → Project → Settings → Environment Variables for the live site.
# Never commit .env.

# ── SMTP: emails each message to you ─────────────────────────────
# Gmail: smtp.gmail.com, port 465, your Gmail address, and an App Password
# (Google Account → Security → 2-Step Verification → App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-character-app-password
# Optional: the "from" address (defaults to SMTP_USER)
MAIL_FROM=
# Where messages are delivered
MAIL_TO=you@gmail.com

# ── Backup: every message is also saved to a PRIVATE GitHub repo ──
# Fine-grained token with access to ONLY that repo, permission
# "Contents: Read and write".
GITHUB_TOKEN=github_pat_xxx
GITHUB_REPO=Umair-Habibx123/portfolio-messages
GITHUB_BRANCH=main

# ── Email verification (visitors confirm their email with a 6-digit code) ──
# A long random string used to sign the pending message. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# (If you leave it out, a key is derived from SMTP_PASS + GITHUB_TOKEN.)
CONTACT_SECRET=
